{
  "name": "porosys-production-workflow-editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Production workflow editor.",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "^24.21.0"
  },
  "scripts": {
    "dev": "concurrently --names client,server --kill-others \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite --config client/vite.config.ts",
    "dev:server": "node --watch server/main.ts",
    "typecheck": "tsc --noEmit -p shared/tsconfig.json && tsc --noEmit -p client/tsconfig.json && tsc --noEmit -p server/tsconfig.json",
    "lint": "eslint --max-warnings 0 .",
    "test": "node --test shared/tests/workflow-domain.test.ts server/tests/workflow-api.test.ts server/tests/workflow-file.test.ts"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "express": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.5"
  }
}
